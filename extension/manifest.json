{
    "manifest_version":  3,
    "name":  "AndacCatcher",
    "version":  "1.5.4",
    "description":  "Sayfalardaki video ve medya kaynaklarını algılar.",
    "permissions":  [
                        "storage",
                        "webRequest",
                        "downloads",
                        "nativeMessaging"
                    ],
    "host_permissions":  [
                             "\u003call_urls\u003e"
                         ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "\u003call_urls\u003e"
                                            ],
                                "js":  [
                                           "content.js"
                                       ],
                                "css":  [
                                            "content.css"
                                        ],
                                "run_at":  "document_idle",
                                "all_frames":  true,
                                "match_about_blank":  true,
                                "match_origin_as_fallback":  true
                            }
                        ],
    "action":  {
                   "default_title":  "Video Catcher",
                   "default_popup":  "popup.html"
               },
    "key":  ""
}